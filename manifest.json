{
  "manifest_version": 3,
  "name": "Meesho Tools",
  "version": "1.0.0",
  "description": "Meesho Autofill + Shipping Optimizer, and Flipkart Autofill, combined into one tabbed extension.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://supplier.meesho.com/*",
    "*://seller.flipkart.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://supplier.meesho.com/*"
      ],
      "js": [
        "selector-utils.js",
        "autofill-content.js",
        "shipping-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://seller.flipkart.com/*"
      ],
      "js": [
        "selector-utils.js",
        "flipkart-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
